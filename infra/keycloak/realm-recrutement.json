{
  "realm": "recrutement",
  "displayName": "Plateforme de recrutement",
  "enabled": true,
  "loginTheme": "recrut",
  "emailTheme": "recrut",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "en"
  ],
  "defaultLocale": "fr",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "plateforme@recrutement.local",
    "fromDisplayName": "Plateforme de recrutement"
  },
  "roles": {
    "realm": [
      {
        "name": "RECRUTEUR",
        "description": "Back-office : missions, vivier, pipeline, facturation"
      },
      {
        "name": "ENTREPRISE",
        "description": "Espace entreprise : suivi des recrutements, shortlists, entretiens, messages"
      },
      {
        "name": "ENTREPRISE_ADMIN",
        "description": "Administrateur d'une entreprise : équipe, nouveaux besoins, propositions commerciales, factures"
      },
      {
        "name": "CANDIDAT",
        "description": "Espace candidat : profil, candidatures, entretiens"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-recrutement",
    "composite": true,
    "composites": {
      "realm": [
        "offline_access",
        "uma_authorization"
      ]
    }
  },
  "clients": [
    {
      "clientId": "frontend",
      "name": "Application React",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "entrepriseId",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "entrepriseId",
            "claim.name": "entrepriseId",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "rootUrl": "http://localhost:3000",
      "baseUrl": "/"
    },
    {
      "clientId": "swagger",
      "name": "Swagger UI des services",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:8082/*",
        "http://localhost:8083/*",
        "http://localhost:8084/*",
        "http://localhost:8085/*",
        "http://localhost:8086/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "compte-service",
      "name": "compte-service (Admin API, inscription)",
      "description": "Crée et active les comptes des candidats et entreprises inscrits en ligne",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "compte-service-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}], \"unmanagedAttributePolicy\": \"ADMIN_EDIT\"}"
          ]
        }
      }
    ]
  },
  "users": [
    {
      "username": "recruteur@recrutement.local",
      "email": "recruteur@recrutement.local",
      "firstName": "Mohammed Amine",
      "lastName": "Recruteur",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "default-roles-recrutement",
        "RECRUTEUR"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "recruteur",
          "temporary": false
        }
      ]
    },
    {
      "username": "client.atlas@recrutement.local",
      "email": "client.atlas@recrutement.local",
      "firstName": "Samir",
      "lastName": "Kettani",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "default-roles-recrutement",
        "ENTREPRISE",
        "ENTREPRISE_ADMIN"
      ],
      "attributes": {
        "entrepriseId": [
          "11111111-1111-1111-1111-111111111111"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "client",
          "temporary": false
        }
      ]
    },
    {
      "username": "candidat@recrutement.local",
      "email": "candidat@recrutement.local",
      "firstName": "Yassine",
      "lastName": "B.",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "default-roles-recrutement",
        "CANDIDAT"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "candidat",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-compte-service",
      "enabled": true,
      "serviceAccountClientId": "compte-service",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    }
  ],
  "passwordPolicy": "length(8) and specialChars(1) and regexPattern(.*[A-Z0-9].*)"
}
