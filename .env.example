# Copier en .env puis adapter. Valeurs de développement local uniquement.
POSTGRES_USER=recrutement
POSTGRES_PASSWORD=recrutement

# Dossier du PC où sont rangés les CV (chemin absolu possible, ex. C:/Users/hp/Documents/recrut-cv)
CV_DIR=./data/cv

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Adresse qui reçoit les notifications du recruteur (visible dans Mailpit : http://localhost:8025)
RECRUTEUR_EMAIL=recruteur@recrutement.local

# Mentions affichées sur les factures PDF
CABINET_NOM=[Nom du cabinet]
CABINET_ADRESSE=[Adresse du cabinet]
CABINET_ICE=[ICE du cabinet]

# Inscription (compte-service) : secret du client Keycloak « compte-service » (doit être celui du realm)
# et clé HMAC des codes SMS. SMS_PROVIDER=console écrit les SMS dans les logs et dans Mailpit.
COMPTE_SERVICE_SECRET=compte-service-secret
INSCRIPTION_SECRET=dev-inscription-secret-a-changer
SMS_PROVIDER=console
# Pour tester les vrais SMS en local : SMS_PROVIDER=zavu et la clé Zavu (zv_live_…).
ZAVU_API_KEY=
ZAVU_SENDER=
